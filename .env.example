# WAREFLOW Enterprise Environment Configuration Example
# Copy to .env or .env.local for local development. DO NOT commit production secrets.

# Warehouse Facility Identifier
VITE_WAREHOUSE_ID=wh-alpha
VITE_WAREHOUSE_NAME="Chicago Central Fulfilment (Alpha)"

# Telemetry Telecommunication WebSocket / Polling Interval (ms)
VITE_TELEMETRY_SYNC_INTERVAL_MS=15000

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
