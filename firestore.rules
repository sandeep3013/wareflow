rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // DEVELOPMENT ONLY
    // WAREFLOW currently runs without Firebase Authentication.
    // Replace these rules with authenticated role-based rules before production.

    // 1. Physical Inventory Records
    match /inventory/{document=**} {
      allow read, write: if true;
    }

    // 2. Product Catalog Definitions
    match /products/{document=**} {
      allow read, write: if true;
    }

    // 3. Warehouse Orders & Line Items
    match /orders/{document=**} {
      allow read, write: if true;
    }

    // 4. Operational Exceptions & Resolution Log
    match /exceptions/{document=**} {
      allow read, write: if true;
    }

    // 5. System, Hub & Facility Settings
    match /settings/{document=**} {
      allow read, write: if true;
    }

    // 6. Analytics & KPI Snapshots
    match /analytics/{document=**} {
      allow read, write: if true;
    }

    // 7. Allocation Batches
    match /allocation/{document=**} {
      allow read, write: if true;
    }

    // 8. Wave Picking Routes
    match /picking/{document=**} {
      allow read, write: if true;
    }

    // 9. Packing & QC Records
    match /packing/{document=**} {
      allow read, write: if true;
    }

    // 10. Outbound Dispatch Manifests
    match /dispatch/{document=**} {
      allow read, write: if true;
    }

    // 11. Sensor & IoT Telemetry Feeds
    match /telemetry/{document=**} {
      allow read, write: if true;
    }
  }
}
