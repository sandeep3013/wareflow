rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for schema validation
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Inventory Collection Rules (Authenticated anonymous session)
    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    // Products Collection Rules
    match /products/{sku} {
      allow read, write: if request.auth != null;
    }

    // Orders Collection Rules
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Operational Exceptions Collection Rules
    match /exceptions/{exceptionId} {
      allow read, write: if request.auth != null;
    }

    // System & Facility Settings Collection Rules
    match /settings/{settingDoc} {
      allow read, write: if request.auth != null;
    }

    // Default fallback for authenticated sessions
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

